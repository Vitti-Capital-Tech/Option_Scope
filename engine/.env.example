# Supabase Configuration (without VITE_ prefix for server-side use)
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Required for LIVE Delta trading: the service_role key lets the engine decrypt
# stored credentials (get_delta_credentials_decrypted is service_role-only).
# Without it, live trading is disabled and paper trading continues normally.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Live order safety switch. TRUE (default) = log intended orders WITHOUT sending.
# Set to false ONLY after validating the dry-run order log against a real account.
DELTA_LIVE_DRYRUN=true

# Optional Delta forwarding proxy (for the browser Verify call to egress from this
# server's whitelisted IP). Set the port to enable it; leave blank to disable.
# Put TLS + a stable hostname (nginx/Caddy on the Elastic IP) in front, and point
# the frontend's VITE_DELTA_PROXY_URL at that hostname.
DELTA_PROXY_PORT=
# CORS origin allowed to call the proxy from the browser (your site). Default '*'.
DELTA_PROXY_ALLOW_ORIGIN=https://trade.vitticapital.ai

# ─────────────────────────────────────────────────────────────────────────────
# ENGINE TIMING / TUNING — all OPTIONAL.
# Every value below already has a sane default in code; set one ONLY to tune a
# live box without a redeploy. Leave the whole block commented out otherwise.
# After changing any of these: pm2 restart optionscope-engine
# ─────────────────────────────────────────────────────────────────────────────

# Entry chase-fill (armed real live). Each attempt sleeps pollMs INSIDE the
# evaluation lock, so attempts × pollMs × legs is added directly to the cycle
# that also has to open the next minute's entries. Keep the product small.
#ENTRY_CHASE_ATTEMPTS=2
#ENTRY_CHASE_POLL_MS=1200
#ENTRY_CHASE_BUMP=1

# Hard ceiling on the entry-PLACEMENT phase of one cycle. Once spent, remaining
# candidates are deferred to the next minute's scan instead of running the cycle
# into the 60s hang guard (which crashes the process for PM2 recovery and takes
# every account's entries down with it). Raise only if you routinely see
# "⏱ Entry phase budget ... spent" in the logs.
#ENTRY_PHASE_BUDGET_MS=25000

# Recent-fills cache (armed real live). POLL = how often the off-lock refresh
# runs; STALE = age past which the cached set is no longer trusted and the exit
# loop holds rather than inferring fills. Lowering POLL detects resting-order
# fills sooner at the cost of more Delta egress.
#LIVE_FILL_POLL_MS=3000
#LIVE_FILL_STALE_MS=30000

# Delta HTTP request deadlines. Reads are bounded tightly (the caller retries on
# the next ~1s tick). WRITES get a long leash on purpose — aborting an order that
# Delta already accepted leaves an orphan on the exchange; don't drop this low.
#DELTA_READ_TIMEOUT_MS=6000
#DELTA_WRITE_TIMEOUT_MS=15000
#DELTA_PUBLIC_TIMEOUT_MS=10000

# Cross-account entry governor window (shared top-of-book depth budget).
#ENTRY_GOVERNOR_WINDOW_MS=8000

# Telegram alerts (per-account chat ids live in the DB; these are the fallback).
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
#TELEGRAM_DEDUPE_MS=
